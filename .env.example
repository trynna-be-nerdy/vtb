# ── Database ─────────────────────────────────────────────────────────────────
# asyncpg URL used by FastAPI and the pipeline worker
DATABASE_URL=postgresql+asyncpg://vtb:vtbpassword@localhost:5432/vtb
# psycopg sync URL used by Alembic migrations
ALEMBIC_DATABASE_URL=postgresql+psycopg://vtb:vtbpassword@localhost:5432/vtb

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Ollama / LLM ──────────────────────────────────────────────────────────────
# Local Ollama server (run: ollama pull gemma4:4b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:4b

# ── API security ──────────────────────────────────────────────────────────────
# Secret key required in X-API-Key header to trigger the pipeline
PIPELINE_API_KEY=change-me-in-production

# ── Task Master AI (for development tooling only) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
