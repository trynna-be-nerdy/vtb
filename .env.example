# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg URL used by FastAPI and the pipeline worker
# Production: Neon (neon.tech) or Render Postgres — use the external connection string
DATABASE_URL=postgresql+asyncpg://vtb:vtbpassword@localhost:5432/vtb
# psycopg sync URL used by Alembic migrations (same host, different driver prefix)
ALEMBIC_DATABASE_URL=postgresql+psycopg://vtb:vtbpassword@localhost:5432/vtb

# ── Redis ─────────────────────────────────────────────────────────────────────
# Production: Upstash Redis (upstash.com) — use the rediss:// TLS URL
REDIS_URL=redis://localhost:6379/0

# ── Ollama / LLM ──────────────────────────────────────────────────────────────
# Local Ollama server (run: ollama pull gemma4:4b)
# Production on Render: expose local Ollama via ngrok (see DEPLOY.md)
#   ngrok http 11434 --host-header=localhost:11434
#   then set OLLAMA_BASE_URL=https://xxxx.ngrok-free.app
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:4b

# ── API security ──────────────────────────────────────────────────────────────
# Secret key required in X-API-Key header to trigger the Python pipeline
PIPELINE_API_KEY=change-me-in-production

# ── Vercel cron security ──────────────────────────────────────────────────────
# Set in Vercel dashboard — Vercel injects this automatically for cron calls
# Also set in frontend/.env.local for local testing of cron endpoint
CRON_SECRET=change-me-in-production

# ── CORS (Python FastAPI) ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins (set in backend/config.py or here)
# Default already includes http://localhost:3000 and https://viewtheboard.vercel.app

# ── Task Master AI (development tooling only — never deploy) ──────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
