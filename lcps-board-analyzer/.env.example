# ── Backend ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://lcps:lcps_dev@localhost:5432/lcps_analyzer
REDIS_URL=redis://localhost:6379
API_KEY=change-me-before-production
DEBUG=false

# ── Ollama / Gemma 4 ─────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:4b
OLLAMA_TIMEOUT=120
GEMMA_MAX_RETRIES=2

# ── Pipeline ─────────────────────────────────────────────────────────────────
PIPELINE_INTERVAL_HOURS=6
PIPELINE_REQUEST_DELAY=4.0
PDF_CHUNK_MAX_CHARS=2000

# ── Frontend (set in Vercel dashboard or .env.local) ─────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/updates
